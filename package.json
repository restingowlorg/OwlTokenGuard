{
  "name": "@restingowlorg/ossec-cryptography",
  "version": "1.0.0",
  "description": "Minimal token-management foundation for Node.js: opaque token issuance and HMAC fingerprints (clean architecture MVP layer)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --declaration",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "token",
    "opaque-token",
    "session-token",
    "refresh-token",
    "hmac",
    "timing-safe",
    "framework-agnostic",
    "backend",
    "nodejs",
    "typescript",
    "security",
    "clean-architecture"
  ],
  "author": "OSSec Platform",
  "license": "MIT",
  "type": "commonjs",
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OSSecPlatform/ossec-cryptography-library"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.8.2"
  }
}
